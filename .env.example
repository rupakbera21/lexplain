# Gemini API Key
# Get your key at: https://aistudio.google.com/app/apikey
# NEVER commit your real key — this file is safe to commit (no real key here)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Grok (xAI) Fallback API Key
# If Gemini API fails or reaches quota, Lexplain automatically falls back to Grok (grok-2-latest).
GROK_API_KEY=your_grok_api_key_here

# Optional: Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=20
